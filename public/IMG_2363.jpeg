<svg viewBox="0 0 700 450" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
  <rect width="100%" height="100%" fill="#0f172a" rx="16" />
  <rect x="20" y="20" width="660" height="410" rx="12" fill="#020617" stroke="#334155" stroke-width="1.5" />
  <text x="40" y="52" fill="#38bdf8" font-size="16" font-weight="bold" font-family="system-ui, sans-serif">DINAMIKA KASUS COVID-19 VS CAKUPAN VAKSINASI DI INDONESIA</text>
  <text x="560" y="52" fill="#94a3b8" font-size="12" font-family="monospace">KODE: IMG_2363</text>
  <line x1="40" y1="65" x2="660" y2="65" stroke="#334155" stroke-width="1" />

  <!-- Grid lines -->
  <g stroke="#1e293b" stroke-width="1" stroke-dasharray="4 4">
    <line x1="85" y1="100" x2="620" y2="100" />
    <line x1="85" y1="160" x2="620" y2="160" />
    <line x1="85" y1="220" x2="620" y2="220" />
    <line x1="85" y1="280" x2="620" y2="280" />
  </g>

  <!-- Axes -->
  <line x1="85" y1="80" x2="85" y2="330" stroke="#64748b" stroke-width="2" />
  <line x1="85" y1="330" x2="620" y2="330" stroke="#64748b" stroke-width="2" />

  <!-- Left Y Axis: Kasus (Red) -->
  <text x="75" y="105" fill="#f87171" font-size="11" text-anchor="end" font-weight="bold">60 rb</text>
  <text x="75" y="165" fill="#f87171" font-size="11" text-anchor="end" font-weight="bold">40 rb</text>
  <text x="75" y="225" fill="#f87171" font-size="11" text-anchor="end" font-weight="bold">20 rb</text>
  <text x="75" y="285" fill="#f87171" font-size="11" text-anchor="end" font-weight="bold">5 rb</text>
  <text x="75" y="335" fill="#64748b" font-size="11" text-anchor="end">0</text>
  <text x="35" y="200" fill="#f87171" font-size="12" font-weight="bold" transform="rotate(-90 35 200)" text-anchor="middle">
    Kasus Harian COVID-19
  </text>

  <!-- Right Y Axis: % Vaksin (Green) -->
  <text x="630" y="105" fill="#34d399" font-size="11" font-weight="bold">100%</text>
  <text x="630" y="165" fill="#34d399" font-size="11" font-weight="bold">75%</text>
  <text x="630" y="225" fill="#34d399" font-size="11" font-weight="bold">50%</text>
  <text x="630" y="285" fill="#34d399" font-size="11" font-weight="bold">25%</text>
  <text x="665" y="200" fill="#34d399" font-size="12" font-weight="bold" transform="rotate(90 665 200)" text-anchor="middle">
    Cakupan Vaksinasi (% Populasi)
  </text>

  <!-- X Axis Timeline -->
  <text x="150" y="350" fill="#cbd5e1" font-size="11" text-anchor="middle">Jul 2021 (Delta)</text>
  <text x="290" y="350" fill="#cbd5e1" font-size="11" text-anchor="middle">Nov 2021 (Vaksin Dosis 1&amp;2)</text>
  <text x="430" y="350" fill="#cbd5e1" font-size="11" text-anchor="middle">Feb 2022 (Omicron)</text>
  <text x="560" y="350" fill="#cbd5e1" font-size="11" text-anchor="middle">Agt 2022 (Booster)</text>

  <!-- CURVE 1: Kasus Harian (Red) -->
  <path d="M 85,310 Q 115,300 150,105 Q 185,260 235,310 Q 285,320 355,315 Q 395,280 430,170 Q 465,280 505,315 L 615,320" fill="none" stroke="#ef4444" stroke-width="4" stroke-linecap="round" />

  <!-- CURVE 2: Vaksin Dosis 1 & 2 (Green) -->
  <path d="M 85,325 Q 145,300 235,240 Q 315,160 415,130 Q 515,115 615,108" fill="none" stroke="#10b981" stroke-width="4" stroke-linecap="round" />

  <!-- CURVE 3: Vaksin Booster (Cyan) -->
  <path d="M 85,328 L 350,328 Q 400,318 460,260 Q 540,200 615,180" fill="none" stroke="#38bdf8" stroke-width="3.5" stroke-dasharray="5 3" stroke-linecap="round" />

  <!-- Legends -->
  <g transform="translate(110, 390)">
    <line x1="0" y1="10" x2="35" y2="10" stroke="#ef4444" stroke-width="4" />
    <text x="42" y="14" fill="#fca5a5" font-size="11" font-weight="bold">Kasus Harian COVID-19</text>

    <line x1="200" y1="10" x2="235" y2="10" stroke="#10b981" stroke-width="4" />
    <text x="242" y="14" fill="#86efac" font-size="11" font-weight="bold">Vaksin Primer (Dosis 1 &amp; 2)</text>

    <line x1="420" y1="10" x2="455" y2="10" stroke="#38bdf8" stroke-width="3.5" stroke-dasharray="5 3" />
    <text x="462" y="14" fill="#7dd3fc" font-size="11" font-weight="bold">Vaksin Booster (Dosis 3)</text>
  </g>
</svg>
